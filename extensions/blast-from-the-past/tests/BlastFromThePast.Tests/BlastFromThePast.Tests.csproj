<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <!-- The extension references the Cove host contracts compile-only; tests load them at runtime. -->
  <ItemGroup>
    <ProjectReference Include="$(CoveSourceRoot)\src\Cove.Sdk\Cove.Sdk.csproj" Condition="'$(UseLocalCoveSource)' == 'true'" />
    <PackageReference Include="Cove.Sdk" Version="$(CoveSdkVersion)" Condition="'$(UseLocalCoveSource)' != 'true'" />
    <ProjectReference Include="$(CoveSourceRoot)\src\Cove.Core\Cove.Core.csproj" Condition="'$(UseLocalCoveCore)' == 'true'" />
    <PackageReference Include="Cove.Core" Version="$(CoveCoreVersion)" Condition="'$(UseLocalCoveCore)' != 'true'" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/BlastFromThePast/BlastFromThePast.csproj" />
  </ItemGroup>

</Project>
